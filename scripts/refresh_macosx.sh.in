#!/usr/bin/env bash

set -euo pipefail

. @MACOSX_CROSS_LIBDIR@/scripts/macosx_tools.sh

MACOSX_SDK_VERSION="${1:-}"

if ! IF_MACOSX_VERSION_DIR "$MACOSX_SDK_VERSION"; then
	DIE "Invalid macOS SDK version: $MACOSX_SDK_VERSION"
fi

MACOSX_SDK="${OSX_SDK}/${MACOSX_SDK_VERSION}"
if [[ -f "${MACOSX_SDK}/.metadata" ]]; then
	if [[ ! -w "${MACOSX_SDK}" ]]; then
		sudo chown -R "$(id -u):$(id -g)" "${MACOSX_SDK}" ||
			DIE "Cannot make macOS SDK writable."
	fi
	rm -f "${MACOSX_SDK}/.metadata"
	GENERATE_MACOSX_SDK_METADATA "${MACOSX_SDK}"
fi

